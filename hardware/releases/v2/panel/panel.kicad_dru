(version 1)
(rule jlcpcb_minimum
  (constraint track_width (min 0.12mm))
  (constraint clearance (min 0.2mm))
  (constraint hole_size (min 0.2mm)))
(rule power_track_width
  (constraint track_width (min 0.22mm))
  (condition "A.hasNetclass('KNX-Power') || A.hasNetclass('DALI-Power') || A.hasNetclass('AUX-Power')"))
(rule power_neck_down_at_fine_pitch_pins
  (constraint track_width (min 0.15mm))
  (condition "(A.hasNetclass('KNX-Power') || A.hasNetclass('DALI-Power') || A.hasNetclass('AUX-Power')) && (A.intersectsCourtyard('U1') || A.intersectsCourtyard('Q2') || A.intersectsCourtyard('U10'))"))
(rule neck_down_at_fine_pitch_pins
  (constraint track_width (min 0.1mm))
  (condition "A.intersectsCourtyard('U1') || A.intersectsCourtyard('Q2') || A.intersectsCourtyard('U10')"))
(rule creepage_selv-knx_dali
  (constraint creepage (min 6.0mm))
  (condition "(A.hasNetclass('SELV-KNX') || A.hasNetclass('KNX-Power')) && (B.hasNetclass('DALI') || B.hasNetclass('DALI-Power'))"))
(rule creepage_selv-knx_selv-aux
  (constraint creepage (min 2.0mm))
  (condition "(A.hasNetclass('SELV-KNX') || A.hasNetclass('KNX-Power')) && (B.hasNetclass('SELV-AUX') || B.hasNetclass('AUX-Power'))"))
(rule creepage_dali_selv-aux
  (constraint creepage (min 6.0mm))
  (condition "(A.hasNetclass('DALI') || A.hasNetclass('DALI-Power')) && (B.hasNetclass('SELV-AUX') || B.hasNetclass('AUX-Power'))"))
