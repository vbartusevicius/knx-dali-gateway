(footprint "XIAO_ESP32C6_Header" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Seeed XIAO ESP32C6 carrier footprint: 2x7 THT pads at 2.54mm pitch, 15.24mm row spacing + EN SMD pad. Source: Seeed OPL KiCad library / Seeed wiki mechanical drawing. Draft — verify pad positions against Seeed's published footprint.")
  (attr through_hole)
  # pad 1 (5V) at top-left; pads increase downward on left, then right row
  # left row x=-7.62, right row x=+7.62; y from -7.62 to +7.62 at 2.54mm pitch
  (pad "1" thru_hole circle (at -7.62 -7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -7.62 -5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at -7.62 -2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -7.62 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at -7.62 2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at -7.62 5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "7" thru_hole circle (at -7.62 7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "8" thru_hole circle (at 7.62 -7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "9" thru_hole circle (at 7.62 -5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "10" thru_hole circle (at 7.62 -2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "11" thru_hole circle (at 7.62 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "12" thru_hole circle (at 7.62 2.54) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "13" thru_hole circle (at 7.62 5.08) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "14" thru_hole circle (at 7.62 7.62) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  # EN pad: SMD on F.Cu, inside the pad field (XIAO bottom pad)
  (pad "15" smd rect (at 0 7.62) (size 1.5 1.5) (layers "F.Cu" "F.Mask"))
  # XIAO module outline (drawn at raised height on the overlay, not as a courtyard)
  (fp_rect (start -8.0 -8.0) (end 8.0 8.0) (stroke (width 0.12) (type dash)) (fill none) (layer "F.Fab"))
  # courtyard — pad field only (passives go under the raised module at a different height)
  (fp_rect (start -8.5 -8.5) (end 8.5 8.5) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_text user "XIAO ESP32C6" (at 0 -10.16) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
)
