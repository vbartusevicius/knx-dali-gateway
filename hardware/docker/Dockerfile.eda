#
# EDA toolchain: KiCad 10 (cli + pcbnew) plus SKiDL for circuit authoring and
# kinet2pcb for netlist-to-board conversion. kicad/kicad publishes amd64
# images only; on arm64 hosts compose runs this under linux/amd64 emulation.
FROM kicad/kicad:10.0.6

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/eda \
    && /opt/eda/bin/pip install --no-cache-dir \
       skidl==2.3.0 \
       kinet2pcb==1.1.4 \
       pyyaml==6.0.3

# SKiDL discovers KiCad's stock libraries through these variables; the
# footprint library table is seeded into the kicad user's config so
# kinet2pcb resolves footprint names.
ENV KICAD10_SYMBOL_DIR=/usr/share/kicad/symbols \
    KICAD10_FOOTPRINT_DIR=/usr/share/kicad/footprints \
    KICAD_SYMBOL_DIR=/usr/share/kicad/symbols \
    PATH=/opt/eda/bin:$PATH
RUN mkdir -p /root/.config/kicad/10.0 \
    && cp /usr/share/kicad/template/fp-lib-table /root/.config/kicad/10.0/fp-lib-table \
    && cp /usr/share/kicad/template/sym-lib-table /root/.config/kicad/10.0/sym-lib-table 2>/dev/null || true

WORKDIR /work
# Non-login shell: `bash -l` sources /etc/profile, which clobbers the PATH
# set above and hides /opt/eda/bin (skidl, kinet2pcb).
ENTRYPOINT ["/bin/bash", "-c"]
