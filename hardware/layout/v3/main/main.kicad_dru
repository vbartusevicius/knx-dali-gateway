(version 1)
(rule jlcpcb_minimum
  (constraint track_width (min 0.12mm))
  (constraint clearance (min 0.2mm))
  (constraint hole_size (min 0.2mm)))
(rule power_track_width
  (constraint track_width (min 0.22mm))
  (condition "A.hasNetclass('KNX-Power') || A.hasNetclass('DALI-Power') || A.hasNetclass('AUX-Power')"))
(rule power_neck_down_at_fine_pitch_pins
  (constraint track_width (min 0.15mm))
  (condition "(A.hasNetclass('KNX-Power') || A.hasNetclass('DALI-Power') || A.hasNetclass('AUX-Power')) && (A.intersectsCourtyard('J3') || A.intersectsCourtyard('J4') || A.intersectsCourtyard('J5') || A.intersectsCourtyard('J6') || A.intersectsCourtyard('Q2'))"))
(rule neck_down_at_fine_pitch_pins
  (constraint track_width (min 0.1mm))
  (condition "A.intersectsCourtyard('J3') || A.intersectsCourtyard('J4') || A.intersectsCourtyard('J5') || A.intersectsCourtyard('J6') || A.intersectsCourtyard('Q2')"))
(rule parts_under_raised_modules
  (constraint courtyard_clearance (min -100mm))
  (condition "A.Reference == 'U5' || B.Reference == 'U5'"))
(rule creepage_selv-knx_dali
  (constraint creepage (min 6.0mm))
  (condition "(A.hasNetclass('SELV-KNX') || A.hasNetclass('KNX-Power')) && (B.hasNetclass('DALI') || B.hasNetclass('DALI-Power')) && !(A.Reference == 'U2' && B.Reference == 'U2') && !(A.Reference == 'U3' && B.Reference == 'U3')"))
(rule creepage_selv-knx_selv-aux
  (constraint creepage (min 2.0mm))
  (condition "(A.hasNetclass('SELV-KNX') || A.hasNetclass('KNX-Power')) && (B.hasNetclass('SELV-AUX') || B.hasNetclass('AUX-Power')) && !(A.Reference == 'U2' && B.Reference == 'U2') && !(A.Reference == 'U3' && B.Reference == 'U3')"))
(rule creepage_dali_selv-aux
  (constraint creepage (min 6.0mm))
  (condition "(A.hasNetclass('DALI') || A.hasNetclass('DALI-Power')) && (B.hasNetclass('SELV-AUX') || B.hasNetclass('AUX-Power')) && !(A.Reference == 'U2' && B.Reference == 'U2') && !(A.Reference == 'U3' && B.Reference == 'U3')"))
