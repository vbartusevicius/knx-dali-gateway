# Python
**/__pycache__
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Hardware: everything the pipeline regenerates (netlists, DSN/SES, review
# renders, fab staging). Committed: circuits, libraries, the routed layouts
# with their KiCad project files, and hardware/releases/.
hardware/build/
*.kicad_prl
*-backups/
fp-info-cache
*.erc
skidl*.log
*_sklib.py

# ETS libraries and keys are KNX Association property: never commit them
*.dll
*ets-signing-key*

# ETS product build output (package.sh) and OpenKNXproducer scratch files
knxprod/build/
knxprod/src/*.debug.xml
knxprod/src/KnxDaliGateway.h
knxprod/ETS
knxprod/ets-cv.zip

# Mechanical: generated case STL/STEP, assembly and renders
mechanical/build/

# Gateway: generated LittleFS partition image and embedded Web UI header
gateway/build/
gateway/src/firmware/WebAssets.hpp

# Devin local MCP config (machine-specific)
.devin/mcp_config.local.json
.claude/mcp_config.local.json
